shell "/usr/bin/zsh"

term "screen-256color"
# terminfo and termcap for nice 256 color terminal
# allow bold colors - necessary for some reason
attrcolor b ".I" 
# tell screen how to set colors. AB = background, AF=foreground 
# erase background with current bg color 
defbce "on" 

# This line makes Detach and Re-attach without losing the regions/windows layout
layout save default

# Turn off the welcome message
startup_message off

# Disable visual bell
vbell off

# Set scrollback buffer to 10000
defscrollback 10000

# Customize the status line
hardstatus alwayslastline
hardstatus string '%{= kG}[ %{G}%H %{g}][%= %{= kw}%?%-Lw%?%{r}(%{W}%n*%f%t%?(%u)%?%{r})%{w}%?%+Lw%?%?%= %{g}][%{B} %m-%d %{W}%c %{g}]'

#Bind to move between regions
bind -k kl focus left
bind -k kr focus right
bind -k ku focus up
bind -k kd focus down

# default windows
screen -t General 0 zsh
screen -t CPU  1 htop
screen -t GPU  2 zsh 
stuff "watch --color gpustat --color -ucpP^M"
screen -t Kinit 3 zsh
stuff "while true; do kinit mb2389@DC.CL.CAM.AC.UK -l 99d -r 99d -kt /local/scratch/mb2389/keytabs/mb2389.keytab; sleep 3600; done^M"
screen -t zsh 4 zsh
stuff "cd ~/scratch^M"

# Layouts
layout autosave on
layout new one
select 0
split -v
focus right
select 1
split
focus down
select 2
focus up
resize -v +6
focus left
resize -h +50

layout attach one

# ALTERNATIVE
# default windows
# screen -t General 0 zsh
# screen -t CPU  1 htop
# screen -t zsh 2 zsh

